---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getNotes } from '../../lib/content';
import { formatDate } from '../../lib/collection-utils';
export async function getStaticPaths() { return (await getNotes()).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary} image={entry.data.cover} article><article class="wrap detail-page note-detail"><a class="back-link" href="/notes/">← 返回所有记录</a><header class="detail-header"><p class="eyebrow">{entry.data.category} / {formatDate(entry.data.date)}{entry.data.sample && ' / 示例记录'}</p><h1>{entry.data.title}</h1><p class="detail-summary">{entry.data.summary}</p></header><img class="detail-cover" src={entry.data.cover} alt={entry.data.coverAlt} width="1200" height="800" fetchpriority="high" />{headings.length > 1 && <nav class="article-toc" aria-label="文章目录"><span class="eyebrow">这篇记录里</span>{headings.filter((h) => h.depth === 2).map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>}<div class="prose"><Content /></div><div class="article-end"><span>谢谢你读到这里。</span><a class="text-link" href="/notes/">更多记录 <Icon name="arrow" /></a></div></article></Base>
