---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site';
---
<Base title="关于我"><div class="wrap page-body"><header class="page-heading"><p class="eyebrow section-kicker">THE PERSON BEHIND THE PAGES</p><h1>你好，<span class="accent">很高兴认识你。</span></h1></header><section class="about-main"><figure class="portrait"><img src={site.portrait} alt={site.portraitAlt} width="640" height="800" /><figcaption>{site.portraitAlt}</figcaption></figure><div class="about-copy"><p class="eyebrow">{site.name}</p><h2>{site.aboutTitle.split('\n').map((line) => <span>{line}</span>)}</h2><p>{site.aboutText}</p><p class="bio-text">{site.bio}</p><div class="tags">{site.interests.map((interest) => <span>{interest}</span>)}</div></div></section>{site.timeline.length > 0 && <section class="timeline"><h2>沿途的脚印</h2>{site.timeline.map((item) => <div><span>{item.year}</span><p>{item.text}</p></div>)}</section>}<section id="contact" class="about-contact"><p class="eyebrow">SAY HELLO</p><h2>让相遇，继续发生。</h2><p>你可以通过以下公开渠道找到我。</p><div class="contact-links">{site.email && <a class="button" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>}{site.socials.map((link) => <a class="button secondary" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<Icon name="external" /></a>)}</div>{!site.email && site.socials.length === 0 && <p class="empty-state">联系方式待补充。</p>}</section></div></Base>
