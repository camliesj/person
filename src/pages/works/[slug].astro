---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../lib/content';
import { formatDate } from '../../lib/collection-utils';
export async function getStaticPaths() { return (await getProjects()).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary} image={entry.data.cover} article>
  <article class="wrap detail-page"><a class="back-link" href="/works/">← 返回全部作品</a><header class="detail-header"><p class="eyebrow">{entry.data.category} / {formatDate(entry.data.date)}{entry.data.sample && ' / 示例作品'}</p><h1>{entry.data.title}</h1><p class="detail-summary">{entry.data.summary}</p><div class="tags">{entry.data.tags.map((tag) => <span>{tag}</span>)}</div></header><img class="detail-cover" src={entry.data.cover} alt={entry.data.coverAlt} width="1200" height="800" fetchpriority="high" />
  <div class="prose"><Content /></div>
  {entry.data.gallery.length > 0 && <div class="gallery">{entry.data.gallery.map((item) => <figure><img src={item.image} alt={item.alt} loading="lazy" width="1000" height="700" /><figcaption>{item.alt}</figcaption></figure>)}</div>}
  {entry.data.links.length > 0 && <div class="detail-links">{entry.data.links.map((link) => <a class="button" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<Icon name="external" /></a>)}</div>}
  <div class="article-end"><span>每一次尝试，都值得被记录。</span><a class="text-link" href="/works/">继续看看 <Icon name="arrow" /></a></div></article>
</Base>
