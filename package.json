{
  "name": "person-journal",
  "version": "1.0.0",
  "private": true,
  "overrides": { "trim": "0.0.3" },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "node scripts/prepare.mjs && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "decap-cms": "3.17.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "wrangler": "4.153.0"
  }
}
